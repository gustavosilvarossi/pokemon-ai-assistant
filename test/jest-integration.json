{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json",
        "useESM": true
      }
    ]
  }
}
