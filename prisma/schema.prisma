generator client {
  provider     = "prisma-client"
  output       = "./prisma-client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model user {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
